POSTGRES_DB=url_db
POSTGRES_USER=admin
# Change this for production
POSTGRES_PASSWORD=secret

#Flask's secret key
#generate with python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secret

# Only needed for production (compose.prod.yaml): the domain nginx serves
# and Let's Encrypt issues the certificate for.
DOMAIN=shortener.example.com